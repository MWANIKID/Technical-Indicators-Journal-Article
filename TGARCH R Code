# 11. FORECAST-ACCURACY METRICS
# =============================================================================
metrics_df <- results_df %>%
  left_join(
    sector_weights,
    by = "Sector"
  ) %>%
  mutate(
    Forecast_Variance = pmax(
      Forecast_Variance,
      TARGET_EPSILON
    ),
    Actual_Variance = pmax(
      Actual_Variance,
      TARGET_EPSILON
    ),
    Forecast_Volatility = sqrt(Forecast_Variance),
    Actual_Volatility = sqrt(Actual_Variance),
    Squared_Error = (
      Actual_Variance -
        Forecast_Variance
    )^2,
    Absolute_Error = abs(
      Actual_Variance -
        Forecast_Variance
    ),
    QLIKE_i = (
      Actual_Variance /
        Forecast_Variance
    ) -
      log(
        Actual_Variance /
          Forecast_Variance
      ) -
      1
  )

sector_losses <- metrics_df %>%
  group_by(Sector, Weight) %>%
  summarise(
    N = n(),
    N_Fallback = sum(Used_Fallback, na.rm = TRUE),
    MSE = mean(Squared_Error, na.rm = TRUE),
    RMSE = sqrt(MSE),
    MAE = mean(Absolute_Error, na.rm = TRUE),
    QLIKE = mean(QLIKE_i, na.rm = TRUE),
    Mean_Eta = mean(Eta, na.rm = TRUE),
    Mean_Volume_Coefficient = mean(
      Volume_Coefficient,
      na.rm = TRUE
    ),
    Mean_Persistence = mean(
      Persistence,
      na.rm = TRUE
    ),
    .groups = "drop"
  )

weighted_metrics <- sector_losses %>%
