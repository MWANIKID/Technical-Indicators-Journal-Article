    N_Sectors = n(),
    RMSE = sqrt(
      sum(Weight * MSE, na.rm = TRUE) /
        sum(Weight[is.finite(MSE)])
    ),
    MAE = sum(
      Weight * MAE,
      na.rm = TRUE
    ) / sum(
      Weight[is.finite(MAE)]
    ),
    QLIKE = sum(
      Weight * QLIKE,
      na.rm = TRUE
    ) / sum(
      Weight[is.finite(QLIKE)]
