}

# =============================================================================
# 4. CONSTRUCT ONE COMMON SECTOR-RETURN SERIES
# =============================================================================
# The same sector return is used:
#   - as the TGARCH-X dependent variable; and
#   - to construct the one-day squared-return evaluation target.
#
# This avoids the original discrepancy between target construction and model
# construction. Volume availability affects the exogenous regressor, not the
# definition of the sector return itself.
sector_daily <- firm_panel %>%
  group_by(Date, Sector) %>%
  summarise(
    Weighted_Return_Sum = sum(
      Market_Cap_Lag1 * Stock_Return,
      na.rm = TRUE
    ),
    Sector_Cap_Lag1 = sum(
      Market_Cap_Lag1,
      na.rm = TRUE
    ),
    Sector_Volume = if (
      sum(is.finite(Trading_Volume)) > 0
    ) {
      sum(Trading_Volume[is.finite(Trading_Volume)], na.rm = TRUE)
    } else {
      NA_real_
    },
    N_Stocks = n_distinct(Stock),
    N_Volume_Stocks = sum(is.finite(Trading_Volume)),
    .groups = "drop"
  ) %>%
  mutate(
    Sector_Return = Weighted_Return_Sum / Sector_Cap_Lag1
  ) %>%
  filter(
    is.finite(Sector_Return),
    is.finite(Sector_Cap_Lag1),
    Sector_Cap_Lag1 > 0
  ) %>%
  arrange(Sector, Date)

