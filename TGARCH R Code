# =============================================================================
safe_variance <- function(x, epsilon = TARGET_EPSILON) {
  value <- suppressWarnings(var(x, na.rm = TRUE))
  
  if (!is.finite(value) || value <= 0) {
    value <- epsilon
  }
  
  max(value, epsilon)
}

standardize_training_regressor <- function(x) {
  x <- as.numeric(x)
  
  center <- mean(x, na.rm = TRUE)
  scale <- sd(x, na.rm = TRUE)
  
  if (!is.finite(center)) {
    stop("The exogenous regressor has a non-finite training mean.")
  }
  
  if (!is.finite(scale) || scale < 1e-12) {
    scale <- 1
  }
  
  list(
    values = (x - center) / scale,
    center = center,
    scale = scale
  )
}

capture_ugarch_fit <- function(specification, data_vector) {
  warning_messages <- character(0)
  error_message <- NA_character_
  
  fit_object <- tryCatch(
    withCallingHandlers(
      ugarchfit(
        spec = specification,
        data = data_vector,
        solver = "hybrid",
        solver.control = list(trace = 0),
        fit.control = list(
          stationarity = 1,
          scale = 0
        )
      ),
      warning = function(w) {
        warning_messages <<- c(
          warning_messages,
          conditionMessage(w)
        )
        invokeRestart("muffleWarning")
      }
    ),
    error = function(e) {
      error_message <<- conditionMessage(e)
      NULL
    }
  )
  
  list(
    fit = fit_object,
    warning = if (
      length(warning_messages) > 0
    ) {
      paste(unique(warning_messages), collapse = " | ")
    } else {
      NA_character_
    },
    error = error_message
  )
}

extract_parameter <- function(parameter_vector, parameter_name) {
  if (parameter_name %in% names(parameter_vector)) {
    return(as.numeric(parameter_vector[parameter_name]))
  }
  
  NA_real_
}

arch_lm_test <- function(standardized_residuals, lags = 10L) {
  z <- as.numeric(standardized_residuals)
  z <- z[is.finite(z)]
  
  if (length(z) <= lags + 5L) {
    return(
      data.frame(
        Statistic = NA_real_,
        DF = lags,
        P_Value = NA_real_
      )
    )
  }
  
  squared <- z^2
  embedded <- embed(squared, lags + 1L)
  
  dependent <- embedded[, 1]
  regressors <- embedded[, -1, drop = FALSE]
  
  auxiliary_fit <- lm(dependent ~ regressors)
  r_squared <- summary(auxiliary_fit)$r.squared
  statistic <- nrow(embedded) * r_squared
  p_value <- pchisq(
    statistic,
    df = lags,
    lower.tail = FALSE
  )
  
  data.frame(
    Statistic = statistic,
    DF = lags,
    P_Value = p_value
  )
}

# =============================================================================
# 8. ROLLING TGARCH-X FORECASTS, SECTOR BY SECTOR
# =============================================================================
sectors <- sort(unique(sector_model_data$Sector))

total_forecasts <- sum(
  vapply(
    sectors,
    function(sector_name) {
      nrow(
        sector_model_data %>%
          filter(Sector == sector_name)
      ) - WINDOW_SIZE
    },
    numeric(1)
  )
)

if (total_forecasts <= 0) {
  stop("No rolling forecasts can be generated.")
}

results <- vector("list", total_forecasts)
result_index <- 0L
successful_fits <- 0L
fallback_fits <- 0L
last_successful_fit <- list()
last_successful_fit_metadata <- list()

progress <- progress_bar$new(
  format = paste0(
    "[:bar] :percent | :current/:total | ",
    "valid TGARCH-X: :success | fallback: :fallback | ETA: :eta"
  ),
  total = total_forecasts,
  clear = FALSE,
  width = 100
)

start_time <- Sys.time()

for (sector_name in sectors) {
  sector_data <- sector_model_data %>%
    filter(Sector == sector_name) %>%
    arrange(Date)
  
  n_sector <- nrow(sector_data)
  n_sector_forecasts <- n_sector - WINDOW_SIZE
  
  for (roll_index in seq_len(n_sector_forecasts)) {
    train_indices <- roll_index:(
      roll_index + WINDOW_SIZE - 1L
    )
    forecast_index <- roll_index + WINDOW_SIZE
    
    training_data <- sector_data[
      train_indices,
      ,
      drop = FALSE
    ]
    
    forecast_row <- sector_data[
      forecast_index,
      ,
      drop = FALSE
    ]
    
    y_unscaled <- training_data$Sector_Return
    y_scaled <- y_unscaled * RETURN_SCALE
    
    fallback_variance <- safe_variance(y_unscaled)
    
    regressor_scaling <- standardize_training_regressor(
      training_data$Volume_Return_Lag1
    )
    
    x_training <- matrix(
      regressor_scaling$values,
      ncol = 1
    )
    colnames(x_training) <- "Volume_Return_Lag1_z"
    
    x_next_value <- (
      forecast_row$Volume_Return_Lag1 -
        regressor_scaling$center
    ) / regressor_scaling$scale
    
    x_forecast <- matrix(
      x_next_value,
      nrow = 1,
      ncol = 1
    )
    colnames(x_forecast) <- "Volume_Return_Lag1_z"
    
    result_index <- result_index + 1L
    
    forecast_variance <- fallback_variance
    fit_converged <- FALSE
    forecast_valid <- FALSE
    used_fallback <- TRUE
    failure_reason <- NA_character_
    fit_warning <- NA_character_
    fit_error <- NA_character_
    
    mu_value <- NA_real_
    omega_value <- NA_real_
    alpha_value <- NA_real_
    beta_value <- NA_real_
    eta_value <- NA_real_
    delta_value <- NA_real_
    shape_value <- NA_real_
    persistence_value <- NA_real_
    
    specification <- tryCatch(
      ugarchspec(
        mean.model = list(
          armaOrder = c(0, 0),
          include.mean = TRUE
        ),
        variance.model = list(
          model = "fGARCH",
          submodel = "TGARCH",
          garchOrder = c(1, 1),
          external.regressors = x_training,
          variance.targeting = FALSE
        ),
        distribution.model = "std"
      ),
      error = function(e) {
        fit_error <<- conditionMessage(e)
        NULL
      }
    )
    
    fit_capture <- NULL
    fit_object <- NULL
    
    if (is.null(specification)) {
      failure_reason <- "specification_error"
    } else {
      fit_capture <- capture_ugarch_fit(
        specification,
        y_scaled
      )
      
      fit_object <- fit_capture$fit
      fit_warning <- fit_capture$warning
      fit_error <- fit_capture$error
      
      if (is.null(fit_object)) {
        failure_reason <- "fit_error"
      } else {
        convergence_code <- tryCatch(
          convergence(fit_object),
          error = function(e) NA_integer_
        )
        
        fit_converged <- isTRUE(
          is.finite(convergence_code) &&
            convergence_code == 0
        )
        
        if (!fit_converged) {
          failure_reason <- "fit_nonconvergence"
        } else {
          forecast_object <- tryCatch(
            ugarchforecast(
              fit_object,
              n.ahead = 1,
              external.forecasts = list(
                vregfor = x_forecast
              )
            ),
            error = function(e) {
              fit_error <<- paste(
                na.omit(
                  c(
                    fit_error,
                    conditionMessage(e)
                  )
                ),
                collapse = " | "
              )
              NULL
            }
          )
          
          if (is.null(forecast_object)) {
            failure_reason <- "forecast_error"
          } else {
            sigma_forecast_scaled <- tryCatch(
              as.numeric(
                sigma(forecast_object)[1]
              ),
              error = function(e) NA_real_
            )
            
            candidate_variance <- (
              sigma_forecast_scaled / RETURN_SCALE
            )^2
            
            forecast_valid <- (
              length(candidate_variance) == 1L &&
                is.finite(candidate_variance) &&
                candidate_variance > 0
            )
            
            if (forecast_valid) {
              forecast_variance <- max(
                candidate_variance,
                TARGET_EPSILON
              )
              used_fallback <- FALSE
              failure_reason <- NA_character_
              successful_fits <- successful_fits + 1L
              
              parameters <- coef(fit_object)
              
              mu_value <- extract_parameter(parameters, "mu")
              omega_value <- extract_parameter(parameters, "omega")
              alpha_value <- extract_parameter(parameters, "alpha1")
              beta_value <- extract_parameter(parameters, "beta1")
              eta_names <- grep("^eta", names(parameters), value = TRUE)
              eta_value <- if (length(eta_names) > 0L) {
                as.numeric(parameters[eta_names[1L]])
              } else {
                NA_real_
              }
              delta_value <- extract_parameter(parameters, "vxreg1")
              shape_value <- extract_parameter(parameters, "shape")
              
              persistence_value <- tryCatch(
                as.numeric(
                  rugarch::persistence(fit_object)
                ),
                error = function(e) NA_real_
              )
              
              last_successful_fit[[sector_name]] <- fit_object
              last_successful_fit_metadata[[sector_name]] <- data.frame(
                Sector = sector_name,
                Window_Start_Date = min(training_data$Date),
                Window_End_Date = max(training_data$Date),
                Forecast_Date = forecast_row$Date,
                stringsAsFactors = FALSE
              )
            } else {
              failure_reason <- "nonfinite_or_nonpositive_forecast"
            }
          }
        }
      }
    }
    
    if (used_fallback) {
      fallback_fits <- fallback_fits + 1L
    }
    
    results[[result_index]] <- data.frame(
      Date = forecast_row$Date,
      Sector = sector_name,
      Window_Start_Date = min(training_data$Date),
      Window_End_Date = max(training_data$Date),
      Window_Observations = WINDOW_SIZE,
      Forecast_Variance = forecast_variance,
      Actual_Variance = pmax(
        forecast_row$Sector_Return^2,
        TARGET_EPSILON
      ),
      Actual_Variance_Raw = forecast_row$Sector_Return^2,
      Sector_Return = forecast_row$Sector_Return,
      Sector_Cap_Lag1 = forecast_row$Sector_Cap_Lag1,
      N_Stocks = forecast_row$N_Stocks,
      Volume_Return_Lag1 = forecast_row$Volume_Return_Lag1,
      Volume_Regressor_Training_Mean = regressor_scaling$center,
      Volume_Regressor_Training_SD = regressor_scaling$scale,
      Converged = fit_converged,
      Forecast_Valid = forecast_valid,
      Used_Fallback = used_fallback,
      Failure_Reason = failure_reason,
      Fit_Warning = fit_warning,
      Fit_Error = fit_error,
      Mu = mu_value,
      Omega = omega_value,
      Alpha1 = alpha_value,
      Beta1 = beta_value,
      Eta = eta_value,
      Volume_Coefficient = delta_value,
      Shape = shape_value,
      Persistence = persistence_value,
      Model = "fGARCH-TGARCH-X(1,1)",
      Forecast_Horizon = 1L,
      Code_Version = CODE_VERSION,
      stringsAsFactors = FALSE
    )
    
    progress$tick(
      tokens = list(
        success = successful_fits,
        fallback = fallback_fits
      )
    )
  }
}

end_time <- Sys.time()
results_df <- bind_rows(results)

if (nrow(results_df) != total_forecasts) {
  stop("Internal error: generated forecast count does not match expectation.")
}

if (anyDuplicated(results_df[, c("Sector", "Date")]) > 0) {
