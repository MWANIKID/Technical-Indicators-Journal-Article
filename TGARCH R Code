# =============================================================================
# 12. RESIDUAL DIAGNOSTICS FOR THE LAST SUCCESSFUL FIT IN EACH SECTOR
# =============================================================================
diagnostic_rows <- list()
sign_bias_rows <- list()

for (sector_name in names(last_successful_fit)) {
  fit_object <- last_successful_fit[[sector_name]]
  metadata <- last_successful_fit_metadata[[sector_name]]
  
  standardized_residuals <- tryCatch(
    as.numeric(
      residuals(
        fit_object,
        standardize = TRUE
      )
    ),
    error = function(e) numeric(0)
  )
  
  standardized_residuals <- standardized_residuals[
    is.finite(standardized_residuals)
  ]
  
  diagnostic_lag <- min(
    DIAGNOSTIC_LAG,
    max(
      1L,
      floor(length(standardized_residuals) / 5L)
    )
  )
  
  lb_residual <- if (
    length(standardized_residuals) > diagnostic_lag + 2L
  ) {
    Box.test(
      standardized_residuals,
      lag = diagnostic_lag,
      type = "Ljung-Box"
    )
  } else {
    NULL
  }
  
  lb_squared <- if (
    length(standardized_residuals) > diagnostic_lag + 2L
  ) {
    Box.test(
      standardized_residuals^2,
      lag = diagnostic_lag,
      type = "Ljung-Box"
    )
  } else {
    NULL
  }
  
  arch_lm <- arch_lm_test(
    standardized_residuals,
    lags = diagnostic_lag
  )
  
  persistence_value <- tryCatch(
    as.numeric(
      rugarch::persistence(fit_object)
    ),
    error = function(e) NA_real_
  )
  
  diagnostic_rows[[sector_name]] <- data.frame(
    Sector = sector_name,
    Window_Start_Date = metadata$Window_Start_Date,
    Window_End_Date = metadata$Window_End_Date,
    Forecast_Date = metadata$Forecast_Date,
    Diagnostic_Lag = diagnostic_lag,
    Ljung_Box_Residual_Statistic = if (
      is.null(lb_residual)
    ) {
      NA_real_
    } else {
      as.numeric(lb_residual$statistic)
    },
    Ljung_Box_Residual_P_Value = if (
      is.null(lb_residual)
    ) {
      NA_real_
    } else {
      lb_residual$p.value
    },
    Ljung_Box_Squared_Residual_Statistic = if (
      is.null(lb_squared)
    ) {
      NA_real_
    } else {
      as.numeric(lb_squared$statistic)
    },
    Ljung_Box_Squared_Residual_P_Value = if (
      is.null(lb_squared)
    ) {
      NA_real_
    } else {
      lb_squared$p.value
    },
    ARCH_LM_Statistic = arch_lm$Statistic,
    ARCH_LM_DF = arch_lm$DF,
    ARCH_LM_P_Value = arch_lm$P_Value,
    Persistence = persistence_value,
    Code_Version = CODE_VERSION,
    stringsAsFactors = FALSE
  )
  
  sign_bias_output <- tryCatch(
    rugarch::signbias(fit_object),
    error = function(e) NULL
  )
  
  if (!is.null(sign_bias_output)) {
    sign_bias_df <- as.data.frame(
      sign_bias_output,
      stringsAsFactors = FALSE
    )
    sign_bias_df$Test <- rownames(sign_bias_df)
    rownames(sign_bias_df) <- NULL
    sign_bias_df$Sector <- sector_name
    sign_bias_df$Window_End_Date <- metadata$Window_End_Date
    sign_bias_df$Forecast_Date <- metadata$Forecast_Date
    sign_bias_df$Code_Version <- CODE_VERSION
    
    sign_bias_rows[[sector_name]] <- sign_bias_df
  }
}

diagnostics_df <- if (
  length(diagnostic_rows) > 0
) {
  bind_rows(diagnostic_rows)
} else {
  data.frame(
