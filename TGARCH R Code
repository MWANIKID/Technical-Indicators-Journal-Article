parse_day_first_date <- function(x) {
  x <- as.character(x)
  
  parsed <- suppressWarnings(as.Date(x, format = "%d/%m/%Y"))
  unresolved <- is.na(parsed)
  
  if (any(unresolved)) {
    parsed[unresolved] <- suppressWarnings(
      as.Date(x[unresolved], format = "%Y-%m-%d")
    )
  }
  
  parsed
}

to_numeric_clean <- function(x) {
  suppressWarnings(
    as.numeric(
      gsub(",", "", as.character(x), fixed = TRUE)
    )
  )
}

