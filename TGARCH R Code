  mutate(
    Stock_Return = log(Close / lag(Close)),
    Market_Cap_Lag1 = lag(Market_Cap)
  ) %>%
  ungroup() %>%
  filter(
    is.finite(Stock_Return),
    is.finite(Market_Cap_Lag1),
    Market_Cap_Lag1 > 0
  )

