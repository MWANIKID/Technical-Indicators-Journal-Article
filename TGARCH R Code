# =============================================================================
# 13. OPTIONAL FORECAST-ERROR STABILITY ANALYSIS
# =============================================================================
# This is exploratory and belongs in supporting information, not the primary
# forecasting comparison. The original incorrectly labelled a generic
# fluctuation process as "CUSUMSQ"; that test is not reproduced here.
if (isTRUE(RUN_STABILITY_TESTS)) {
  forecast_errors_df <- metrics_df %>%
    group_by(Date) %>%
    summarise(
      Weight_Sum = sum(
        Weight,
        na.rm = TRUE
      ),
      Error = sum(
        Weight * (
          Actual_Volatility -
            Forecast_Volatility
        ),
        na.rm = TRUE
      ) / Weight_Sum,
      .groups = "drop"
    ) %>%
    filter(
      is.finite(Error),
      is.finite(Weight_Sum),
      Weight_Sum > 0
    ) %>%
    arrange(Date)
  
  write.csv(
    forecast_errors_df,
    file.path(
      OUTPUT_DIR,
      "TGARCH_X_Forecast_Errors.csv"
    ),
    row.names = FALSE
  )
  
  if (nrow(forecast_errors_df) >= 40) {
    recursive_cusum <- efp(
      Error ~ 1,
      data = forecast_errors_df,
      type = "Rec-CUSUM"
    )
    
    recursive_cusum_result <- sctest(
      recursive_cusum
    )
    
    cusum_result_df <- data.frame(
      Test = "Recursive CUSUM",
      Statistic = as.numeric(
        recursive_cusum_result$statistic
      ),
      P_Value = recursive_cusum_result$p.value,
      Code_Version = CODE_VERSION
    )
    
    write.csv(
      cusum_result_df,
      file.path(
        OUTPUT_DIR,
        "TGARCH_X_CUSUM_Test_Result.csv"
      ),
      row.names = FALSE
    )
    
    png(
      file.path(
        OUTPUT_DIR,
        "TGARCH_X_CUSUM_Plot.png"
      ),
      width = 900,
      height = 650
    )
    plot(
      recursive_cusum,
      main = "Recursive CUSUM: Weighted TGARCH-X Forecast Error"
    )
    dev.off()
    
    breakpoint_full <- breakpoints(
      Error ~ 1,
      data = forecast_errors_df,
      h = 0.15
    )
    
    bic_values <- BIC(breakpoint_full)
    optimal_breaks <- which.min(bic_values) - 1L
    
    breakpoint_bic_df <- data.frame(
      Number_of_Breaks = 0:(length(bic_values) - 1L),
      BIC = as.numeric(bic_values),
      Selected = (
        0:(length(bic_values) - 1L)
      ) == optimal_breaks,
      Code_Version = CODE_VERSION
    )
    
    write.csv(
      breakpoint_bic_df,
      file.path(
        OUTPUT_DIR,
        "TGARCH_X_Breakpoint_BIC.csv"
      ),
      row.names = FALSE
    )
    
    if (optimal_breaks > 0) {
      selected_breakpoints <- breakpoints(
        breakpoint_full,
        breaks = optimal_breaks
      )
      
      breakpoint_indices <- selected_breakpoints$breakpoints
      breakpoint_indices <- breakpoint_indices[
        is.finite(breakpoint_indices)
      ]
      
      breakpoint_df <- data.frame(
        Breakpoint_Number = seq_along(
          breakpoint_indices
        ),
        Observation_Index = breakpoint_indices,
        Breakpoint_Date = forecast_errors_df$Date[
          breakpoint_indices
        ],
        Code_Version = CODE_VERSION
      )
    } else {
      breakpoint_df <- data.frame(
        Message = "BIC selected no structural break.",
        Code_Version = CODE_VERSION
      )
    }
    
    write.csv(
      breakpoint_df,
      file.path(
        OUTPUT_DIR,
        "TGARCH_X_Breakpoints.csv"
      ),
      row.names = FALSE
    )
    
    png(
      file.path(
        OUTPUT_DIR,
        "TGARCH_X_Breakpoint_Detection.png"
      ),
      width = 900,
      height = 650
    )
    plot(
      breakpoint_full,
      main = "Breakpoint F-statistics: Weighted TGARCH-X Forecast Error"
    )
    dev.off()
  } else {
    write.csv(
      data.frame(
        Message = "Too few observations for the optional stability analysis."
      ),
      file.path(
        OUTPUT_DIR,
        "TGARCH_X_Stability_Not_Run.csv"
      ),
      row.names = FALSE
    )
  }
}

